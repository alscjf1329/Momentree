# 어드민 로그인 코드를 받을 이메일 주소
ADMIN_EMAIL=your-email@example.com

# 코드를 발송할 Gmail 계정 (ADMIN_EMAIL과 같아도 됨)
GMAIL_USER=your-gmail@gmail.com
# Google 계정 2단계 인증 활성화 후 발급받은 앱 비밀번호 (일반 비밀번호 아님)
# 발급: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 세션 서명용 랜덤 문자열 (예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me

# 계좌번호/예금주 저장 시 암호화에 쓰는 키 (base64, 32바이트 — openssl rand -base64 32)
ENCRYPTION_KEY=change-me

# 고객/RSVP/OTP 데이터, 업로드 이미지·오디오를 저장할 절대경로 (선택)
# 미설정 시 process.cwd() 기준 상대경로 사용 — PM2가 .next/standalone 등
# 프로젝트 루트가 아닌 곳에서 프로세스를 띄우는 배포 환경이면 반드시 절대경로로 지정할 것
# DATA_DIR=/app/Momentree/data
# PUBLIC_DIR=/app/Momentree/public
